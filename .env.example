# ============================================================
#  EDI - configuración. Copia este archivo a .env y edítalo.
#  (scripts/02_configurar.sh lo hace por ti)
# ============================================================

# Cómo quieres que EDI te llame
EDI_USER_NAME=jefe
TZ=America/Mexico_City

# ---------- Inteligencia artificial (todas gratuitas) ----------
# groq   = recomendado: gratis y muy rápido -> https://console.groq.com/keys
# gemini = alternativa gratis               -> https://aistudio.google.com/apikey
# openrouter = respaldo gratis (modelos :free) -> https://openrouter.ai/keys
# none   = sin IA (EDI funciona sólo con comandos)
LLM_PROVIDER=groq
LLM_FALLBACK=openrouter,gemini

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

LLM_MAX_TOKENS=350

# OmniRoute (tu pivote local de IA). También se configura desde Ajustes → Inteligencia.
OMNIROUTE_URL=http://host.docker.internal:20128/v1
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=auto/best-free

# v0.8: más proveedores, todos opcionales — agrégalos desde Ajustes → Inteligencia (ahí les pones "tag"
# para preferirlos en programar/imágenes). No son gratis como Groq/Gemini/OpenRouter, pero si ya tienes
# cuenta en alguno (ChatGPT, Claude, DeepSeek) EDI los puede usar igual.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=

# v0.8: carpeta que EDI puede leer/resumir/corregir (PDFs, Word, código...). Nunca toca nada fuera de
# ella. Por defecto es ./data/files (dentro del repo); si quieres darle una carpeta real de tu Mac,
# cambia el volumen en docker-compose.yml por algo como "~/Documents/EDI-files:/files".
EDI_FILES_DIR=/files

# ---------- Correo ----------
# Lo recomendado ahora es registrar tus correos desde Ajustes → Correos (formulario).
# Las cuentas se definen en config/accounts.yaml.
# Aquí van SOLO las contraseñas de aplicación (nunca tu contraseña normal).
GMAIL_PERSONAL_PASS=
GMAIL_ESCUELA_PASS=
YAHOO_PASS=
ICLOUD_PASS=

# Sólo si lees Outlook/Hotmail directo (ver docs/CUENTAS_CORREO.md)
MS_CLIENT_ID=

MAIL_MAX_PER_ACCOUNT=15
# Cada cuántos minutos avisar de correo nuevo (0 = nunca)
MAIL_CHECK_MINUTES=15

# ---------- Voz local opcional (Whisper en el contenedor) ----------
# Por defecto la voz la procesa el navegador (no consume tu Mac).
WITH_WHISPER=false
WHISPER_MODEL=base

# ---------- Acceso desde fuera de casa (Tailscale, opcional) ----------
# scripts/edi.sh los llena solo al arrancar (vacíos = sin Tailscale, EDI funciona sólo en tu Wi‑Fi)
EDI_LAN_HOST=
EDI_TS_HOST=
EDI_TS_DNS=
EDI_TS_URL=
EDI_TS_ENABLE_URL=
# 0 = no usar «tailscale serve» (sólo el acceso directo https://IP-100.x:8766)
EDI_TS_SERVE=1
